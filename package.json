{
  "name": "yqweb-cad",
  "version": "0.4.0",
  "private": true,
  "description": "YQArch CAD — 2D CAD editor (web + Windows desktop)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install && npm --prefix tools/dwg-convert install",
    "convert": "tsx src/pipeline/convert.ts --src ../Jdjdjehfjthgfh --out assets",
    "convert:dwg": "npm --prefix tools/dwg-convert run convert -- --src ../../../Jdjdjehfjthgfh --out ../../assets/blocks",
    "convert:all": "npm run convert:dwg && npm run convert",
    "preview": "tsx src/preview/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "preview:web": "vite preview",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/rbush": "^3.0.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "dxf-parser": "^1.1.2",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "rbush": "^3.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "main": "electron/main.cjs",
  "author": "YQArch CAD",
  "build": {
    "appId": "com.yqarch.webcad",
    "productName": "YQArch CAD",
    "artifactName": "${productName}-${version}-${arch}-${target}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YQArch CAD",
      "language": "1025",
      "installerLanguages": [
        "ar_SA",
        "en_US"
      ],
      "multiLanguageInstaller": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  }
}
